###################################
# Privra Mail Server Configuration
###################################

# Mailu main configuration file
#
# IMPORTANT: Update these values before running!

###################################
# Common configuration variables
###################################

# Set to a randomly generated 16 bytes string
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING

# Subnet of the docker network (do not change unless you know what you're doing)
SUBNET=192.168.203.0/24

# CRITICAL FIX: Disable DNSSEC validation to avoid Docker DNS issues
# Set to False to use Docker's default DNS (which doesn't support DNSSEC)
DEFER_ON_TLS_ERROR=True
ADMIN_LOG_FORWARD=False

# Main mail domain - CHANGE THIS!
DOMAIN=privra.xyz

# Hostnames for this server (comma-separated)
# This should be the public hostname of your server
HOSTNAMES=mail.privra.xyz

# Postmaster local part (will become postmaster@privra.com)
POSTMASTER=admin

# Choose how secure connections will behave
# TLS_FLAVOR options:
#   - letsencrypt (automatic certificates - RECOMMENDED)
#   - cert (manually provided certificates)
#   - notls (no TLS, not recommended)
#   - mail (TLS only for mail, not web)
TLS_FLAVOR=letsencrypt

# Authentication rate limit per IP (per /24 on ipv4 and /56 on ipv6)
AUTH_RATELIMIT_IP=60/hour

# Authentication rate limit per user
AUTH_RATELIMIT_USER=100/day

# Opt-out of statistics, set to "True" to opt out
DISABLE_STATISTICS=True

###################################
# Optional features
###################################

# Expose the admin interface (value: true, false)
ADMIN=true

# Choose which webmail to run if any (values: roundcube, rainloop, none)
WEBMAIL=roundcube

# Dav server implementation (value: radicale, none)
WEBDAV=none

# Antivirus solution (value: clamav, none)
# Note: ClamAV requires at least 2GB RAM
ANTIVIRUS=none

###################################
# Mail settings
###################################

# Message size limit in bytes
# Default: 50MB
MESSAGE_SIZE_LIMIT=50000000

# Message retention in days for deleted messages
# Set to 0 to disable
MESSAGE_RETENTION_DAYS=30

# Networks granted relay permissions
# Use this with care, generally you want the default value
RELAYNETS=

# Will relay all outgoing mails if configured
RELAYHOST=

# Enable fetchmail (fetch emails from external IMAP/POP3 accounts)
FETCHMAIL_ENABLED=False

# Recipient delimiter, character used to delimiter localpart from custom address part
RECIPIENT_DELIMITER=+

# DMARC rua and ruf email
DMARC_RUA=admin
DMARC_RUF=admin

# Welcome email, enable and set a topic and body if you wish to send welcome
# emails to all users.
WELCOME=false
WELCOME_SUBJECT=Welcome to Privra Mail
WELCOME_BODY=Welcome! Your encrypted email account is ready.

# Maildir Compression
# choose compression-method, default: none (value: bz2, gz, lz4, zstd)
COMPRESSION=
# change compression-level, default: 6 (value: 1-9)
COMPRESSION_LEVEL=

###################################
# Web settings
###################################

# Path to redirect / to
# Default: /webmail
WEBROOT_REDIRECT=/webmail

# Website name
SITENAME=Privra Mail

# Linked Website URL
WEBSITE=https://privra.com

# Default password scheme for newly created accounts
# Options: PBKDF2, BLF-CRYPT, SHA512-CRYPT, SHA256-CRYPT, MD5-CRYPT, CRYPT
CREDENTIAL_ROUNDS=12

# Header to take the real ip from
REAL_IP_HEADER=X-Forwarded-For

# IPs for nginx set_real_ip_from (CIDR list separated by commas)
REAL_IP_FROM=

# enable encryption at rest for all users
# requires per-user Mailu-Storage
ENCRYPTION=true

###################################
# Advanced settings
###################################

# Docker image organization and prefix (Mailu uses GitHub Container Registry)
DOCKER_ORG=ghcr.io/mailu
DOCKER_PREFIX=

# Mailu version to use (Year.Month format)
MAILU_VERSION=2024.06

# Database settings (optional, uses SQLite by default)
# DB_FLAVOR=postgresql
# DB_HOST=database
# DB_PORT=5432
# DB_NAME=mailu
# DB_USER=mailu
# DB_PW=changeme

# Log level threshold in start.py (can be used to increase verbosity)
# LOG_LEVEL=WARNING

# Timezone for the containers
# TZ=UTC

# Default spam threshold used for new users
# SPAM_THRESHOLD=80.0
