# Privra Mail Server Configuration

# Mail domain and hostname
MAIL_DOMAIN=yourdomain.com
MAIL_HOSTNAME=mail.yourdomain.com

# Web interface hostnames (optional - defaults to mail/admin.MAIL_DOMAIN)
WEBMAIL_HOSTNAME=mail.yourdomain.com
ADMIN_HOSTNAME=admin.yourdomain.com

# Database configuration
DB_NAME=privramail
DB_USER=privramail
DB_PASSWORD=your-secure-database-password-here

# Secret key for admin interface (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Admin email (for Let's Encrypt notifications)
ADMIN_EMAIL=admin@yourdomain.com

# PortID Authentication (optional - leave empty to disable)
# Get these from your PortID instance at https://github.com/Harboria-Labs/PortID
PORTID_APP_ID=privra-mail-v1
PORTID_API_URL=http://localhost:5001

# X402 Payment Configuration (for AI agents and spam prevention)
# Payment addresses for receiving USDC
X402_SOLANA_ADDRESS=your-solana-wallet-address-here
X402_BASE_ADDRESS=your-evm-wallet-address-here

# X402 Payment Settings
X402_DEFAULT_AMOUNT_USDC=0.01
X402_DEFAULT_NETWORK=base-sepolia
X402_TIMEOUT_SECONDS=3600
X402_BASE_URL=https://admin.yourdomain.com/x402

# RPC URLs (optional - uses public RPCs by default)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org

# AI Categorization Service
CATEGORIZATION_INTERVAL=60
